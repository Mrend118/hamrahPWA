# آدرس پایه API بک‌اند. در توسعه می‌توانید خالی بگذارید تا از پروکسی Vite استفاده شود.
VITE_API_BASE_URL=/api

# حالت داده آزمایشی (mock). برای اتصال به بک‌اند واقعی مقدار را false کنید.
VITE_USE_MOCK=true

# روش احراز هویت: token | cookie  (بک‌اند تعیین می‌کند)
VITE_AUTH_MODE=token

# تایم‌اوت درخواست‌ها (میلی‌ثانیه)
VITE_API_TIMEOUT=15000
